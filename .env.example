# Server-only pooled Neon connection string. Never prefix it with NEXT_PUBLIC_.
DATABASE_URL=

# GoDaddy Poynt Collect environment: "ote" or "production". Use the environment
# GoDaddy assigns to the authorized test merchant; some Test Lab merchants use production URLs.
POYNT_ENVIRONMENT=
POYNT_APPLICATION_ID=
POYNT_BUSINESS_ID=
POYNT_STORE_ID=

# Server-only RSA private key. Escaped \n line breaks are supported.
POYNT_PRIVATE_KEY=

# Random value of at least 32 characters. Rotating it invalidates open checkout links.
ORDER_SIGNING_SECRET=
