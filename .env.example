# Server-only Neon connection string. Use a separate sandbox database/branch.
DATABASE_URL=

# Born From Water sandbox, independently verified through Stripe on 2026-09-29.
# Prefer a restricted test API key (rk_test_...) with minimum necessary permissions.
# This account ID is not an API key.
STRIPE_ACCOUNT_ID=acct_1UKmEIE3bgUZeCZr
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Keep the existing signing secret to preserve historical signed order links.
# For a new sandbox DB, generate a random value with at least 32 characters.
ORDER_SIGNING_SECRET=
APP_URL=http://localhost:3000

# Owner-confirmed shipping: Canada only, CA$10 flat per order.
STRIPE_SHIPPING_COUNTRIES=CA
STRIPE_SHIPPING_CENTS=1000
# Keep tax disabled until origin, product tax code and registrations are confirmed.
STRIPE_AUTOMATIC_TAX=false

# Live mode needs explicit shipping/tax settings. Keep sandbox branches false.
STRIPE_ALLOW_LIVE=false
# Only the deliberately configured live preview branch may accept real payments.
STRIPE_ALLOW_LIVE_PREVIEW=false
STRIPE_LIVE_PREVIEW_BRANCH=

# Private owner portal. Generate with npm run admin:credentials.
# Deploy these two server-only values; never deploy the plaintext owner password.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
